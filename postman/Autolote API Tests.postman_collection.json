    {
      "name": "LOGIN (GUARDAR TOKEN)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Verificar status\r",
              "pm.test(\"Status code es 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Verificar estructura de respuesta\r",
              "pm.test(\"Respuesta tiene token\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.data).to.have.property(\"token\");\r",
              "});\r",
              "\r",
              "// GUARDAR EL TOKEN Y DATOS DEL USUARIO\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "if (jsonData.data && jsonData.data.token) {\r",
              "    // Guardar token\r",
              "    const token = jsonData.data.token;\r",
              "    pm.environment.set(\"auth_token\", token);\r",
              "    console.log(\"✅ TOKEN GUARDADO EXITOSAMENTE\");\r",
              "    console.log(\"Token (primeros 50 caracteres):\", token.substring(0, 50) + \"...\");\r",
              "    \r",
              "    // Guardar datos del usuario\r",
              "    if (jsonData.data.user) {\r",
              "        pm.environment.set(\"user_id\", jsonData.data.user.id);\r",
              "        pm.environment.set(\"user_rol\", jsonData.data.user.rol);\r",
              "        console.log(\"✅ Usuario ID:\", jsonData.data.user.id);\r",
              "        console.log(\"✅ Rol:\", jsonData.data.user.rol);\r",
              "    }\r",
              "    \r",
              "    // Mostrar mensaje en la interfaz\r",
              "    pm.test(\"Token guardado correctamente\", function () {\r",
              "        pm.expect(pm.environment.get(\"auth_token\")).to.not.be.empty;\r",
              "    });\r",
              "    \r",
              "} else {\r",
              "    console.log(\"❌ ERROR: No se recibió token\");\r",
              "    console.log(\"Respuesta completa:\", jsonData);\r",
              "    pm.test(\"No se recibió token\", function () {\r",
              "        throw new Error(\"La respuesta no contiene token\");\r",
              "    });\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
