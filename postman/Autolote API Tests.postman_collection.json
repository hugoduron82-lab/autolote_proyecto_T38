    {
      "name": "Registrar Usuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Verificar status 201\r",
              "pm.test(\"Status code es 201 Created\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "// Verificar estructura de respuesta\r",
              "pm.test(\"Respuesta tiene formato correcto\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"status\");\r",
              "    pm.expect(jsonData).to.have.property(\"message\");\r",
              "    pm.expect(jsonData).to.have.property(\"data\");\r",
              "});\r",
              "\r",
              "// Verificar que el usuario se creó con los datos correctos\r",
              "pm.test(\"Datos del usuario son correctos\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.data.nombre).to.eql(\"Carlos\");\r",
              "    pm.expect(jsonData.data.apellido).to.eql(\"Mendoza\");\r",
              "    pm.expect(jsonData.data.email).to.eql(\"carlos@test.com\");\r",
              "});\r",
              "\r",
              "// Guardar el ID del usuario para pruebas posteriores\r",
              "const jsonData = pm.response.json();\r",
              "if (jsonData.data && jsonData.data.id) {\r",
              "    pm.environment.set(\"usuario_id\", jsonData.data.id);\r",
              "    console.log(\"✅ Usuario creado con ID:\", jsonData.data.id);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
